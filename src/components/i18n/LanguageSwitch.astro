---
import { es, en } from "../../data/i18n/strings";
---

<button
	id="languageToggle"
	class="chip magnetic"
	type="button"
	aria-label={es["lang.toggle"]}
	data-i18n-aria-es={es["lang.toggle"]}
	data-i18n-aria-en={en["lang.toggle"]}
>
	EN
</button>

<style>
	.chip {
		min-height: 2.4rem;
		min-width: 2.9rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--r-sm);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.06em;
		transition: border-color 160ms var(--ease-survey), color 160ms var(--ease-survey);
	}

	.chip:hover {
		border-color: var(--survey);
		color: var(--survey);
	}
</style>
