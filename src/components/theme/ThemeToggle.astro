---
import { es, en } from "../../data/i18n/strings";
---

<button
	id="themeToggle"
	class="chip magnetic"
	type="button"
	aria-label={es["theme.toggle"]}
	data-i18n-aria-es={es["theme.toggle"]}
	data-i18n-aria-en={en["theme.toggle"]}
	aria-pressed="false"
>
	<svg class="chip__icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.6" />
		<path
			d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
		></path>
	</svg>
	<span class="theme-label" data-es={es["theme.label.dark"]} data-en={en["theme.label.dark"]}
		>{es["theme.label.dark"]}</span
	>
</button>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.4rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--r-sm);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.04em;
		transition: border-color 160ms var(--ease-survey), color 160ms var(--ease-survey);
	}

	.chip:hover {
		border-color: var(--survey);
		color: var(--survey);
	}

	.chip__icon {
		flex: none;
	}
</style>
