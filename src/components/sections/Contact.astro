---
import { site } from "../../data/site";
import { es, en } from "../../data/i18n/strings";
import SheetHeader from "../ui/SheetHeader.astro";

const channels = [
	{
		href: site.social.linkedin,
		label: "LinkedIn",
		descKey: "contact.channel.linkedin",
		external: true,
		primary: true,
	},
	{
		href: site.social.github,
		label: "GitHub",
		descKey: "contact.channel.github",
		external: true,
		primary: false,
	},
	{
		href: site.protected.downloadCvPath,
		labelKey: "hero.cta.cv",
		descKey: "contact.channel.cv",
		external: false,
		primary: false,
	},
	{
		href: site.protected.emailPath,
		labelKey: "contact.viewEmail",
		descKey: "contact.channel.email",
		external: false,
		primary: false,
	},
] as const;
---

<section id="contact" class="waypoint atlas" aria-labelledby="contact-title">
	<div class="waypoint__grid reveal">
		<div class="waypoint__lead">
			<SheetHeader
				id="contact-title"
				designation={{ es: es["contact.designation"], en: en["contact.designation"] }}
				coord="05 / 05"
				title={{ es: es["contact.title"], en: en["contact.title"] }}
			/>
			<p class="waypoint__subtitle" data-es={es["contact.subtitle"]} data-en={en["contact.subtitle"]}>
				{es["contact.subtitle"]}
			</p>
			<p class="waypoint__helper mono" data-es={es["contact.helper"]} data-en={en["contact.helper"]}>
				{es["contact.helper"]}
			</p>
			<p id="copyStatus" class="waypoint__status" role="status" aria-live="polite"></p>
		</div>

		<ul class="waypoint__channels">
			{
				channels.map((ch, index) => {
					const label = "label" in ch ? ch.label : es[ch.labelKey];
					const labelEs = "label" in ch ? ch.label : es[ch.labelKey];
					const labelEn = "label" in ch ? ch.label : en[ch.labelKey];
					return (
						<li>
							<a
								href={ch.href}
								class:list={["channel", "magnetic", { "channel--primary": ch.primary }]}
								target={ch.external ? "_blank" : undefined}
								rel={ch.external ? "noreferrer" : undefined}
							>
								<span class="channel__idx tnum">{String(index + 1).padStart(2, "0")}</span>
								<span class="channel__text">
									<span class="channel__label" data-es={labelEs} data-en={labelEn}>
										{label}
									</span>
									<span class="channel__desc" data-es={es[ch.descKey]} data-en={en[ch.descKey]}>
										{es[ch.descKey]}
									</span>
								</span>
								<svg class="channel__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M5 12h14M13 6l6 6-6 6"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.waypoint {
		padding-block: clamp(4rem, 10vw, 8rem);
	}

	.waypoint__grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
		align-items: start;
	}

	.waypoint__subtitle {
		margin-top: 1.25rem;
		max-width: 42ch;
		font-size: var(--text-lg);
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.waypoint__helper {
		margin-top: 1rem;
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
		color: var(--ink-faint);
	}

	.waypoint__status {
		margin-top: 0.75rem;
		min-height: 1.4rem;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--datum);
	}

	.waypoint__channels {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--hairline);
	}

	.channel {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.25rem;
		padding: 1.35rem 0.5rem 1.35rem 0;
		border-bottom: 1px solid var(--hairline);
		color: var(--ink);
		transition: padding-left 200ms var(--ease-survey), color 160ms var(--ease-survey);
	}

	.channel:hover,
	.channel:focus-visible {
		color: var(--survey);
		padding-left: 0.65rem;
	}

	.channel__idx {
		font-size: var(--text-xs);
		color: var(--ink-faint);
	}

	.channel:hover .channel__idx {
		color: var(--survey);
	}

	.channel__text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.channel__label {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--text-xl);
		letter-spacing: -0.01em;
	}

	.channel__desc {
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}

	.channel__arrow {
		flex: none;
		transform: translateX(-4px);
		opacity: 0.5;
		transition: transform 200ms var(--ease-survey), opacity 200ms var(--ease-survey);
	}

	.channel:hover .channel__arrow {
		transform: translateX(0);
		opacity: 1;
	}

	.channel--primary .channel__label {
		color: var(--survey);
	}

	@media (min-width: 900px) {
		.waypoint__grid {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
</style>
