---
import { es, en } from "../../data/i18n/strings";
import SheetHeader from "../ui/SheetHeader.astro";

const layers = [
	{ key: "about.layer1" },
	{ key: "about.layer2" },
	{ key: "about.layer3" },
	{ key: "about.layer4" },
	{ key: "about.layer5" },
] as const;
---

<section class="about atlas" aria-labelledby="about-title">
	<div class="about__grid reveal">
		<div class="about__lead">
			<SheetHeader
				id="about-title"
				designation={{ es: es["about.designation"], en: en["about.designation"] }}
				coord="01 / 05"
				title={{ es: es["about.title"], en: en["about.title"] }}
			/>
		</div>

		<div class="about__body">
			<p data-es={es["about.body1"]} data-en={en["about.body1"]}>{es["about.body1"]}</p>
			<p data-es={es["about.body2"]} data-en={en["about.body2"]}>{es["about.body2"]}</p>

			<ul class="about__route" aria-hidden="true">
				{
					layers.map((layer, index) => (
						<li class="about__layer">
							<span class="about__layer-idx tnum">{String(index + 1).padStart(2, "0")}</span>
							<svg class="about__layer-mark" width="11" height="11" viewBox="0 0 11 11">
								<path d="M5.5 1 10 9.5H1L5.5 1Z" fill="none" stroke="currentColor" stroke-width="1.2" />
							</svg>
							<span class="about__layer-name" data-es={es[layer.key]} data-en={en[layer.key]}>
								{es[layer.key]}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.about {
		padding-block: clamp(4rem, 10vw, 8rem);
	}

	.about__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.about__body {
		display: grid;
		gap: 1.5rem;
		max-width: var(--measure);
		font-size: var(--text-lg);
		line-height: 1.7;
		color: var(--ink-muted);
	}

	.about__route {
		list-style: none;
		padding: 0;
		margin-top: 0.75rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		border-top: 1px solid var(--hairline);
		padding-top: 1.5rem;
	}

	.about__layer {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.about__layer-idx {
		font-size: var(--text-xs);
		color: var(--ink-faint);
	}

	.about__layer-mark {
		color: var(--survey);
	}

	.about__layer-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink);
	}

	@media (min-width: 900px) {
		.about__grid {
			grid-template-columns: 0.85fr 1.15fr;
		}
	}
</style>
