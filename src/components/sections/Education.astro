---
import { education, educationStats } from "../../data/education";
import { es, en } from "../../data/i18n/strings";
import SheetHeader from "../ui/SheetHeader.astro";
---

<section class="edu atlas" aria-labelledby="education-title">
	<div class="edu__top reveal">
		<div>
			<SheetHeader
				id="education-title"
				designation={{ es: es["education.designation"], en: en["education.designation"] }}
				coord="04 / 05"
				title={{ es: es["education.title"], en: en["education.title"] }}
			/>
			<p class="edu__subtitle" data-es={es["education.subtitle"]} data-en={en["education.subtitle"]}>
				{es["education.subtitle"]}
			</p>
		</div>

		<dl class="edu__readings" aria-hidden="true">
			{
				educationStats.map((stat) => (
					<div class="reading">
						<dt class="reading__v tnum">{stat.value}</dt>
						<dd class="reading__k" data-es={stat.label.es} data-en={stat.label.en}>
							{stat.label.es}
						</dd>
					</div>
				))
			}
		</dl>
	</div>

	<ol class="edu__points reveal">
		{
			education.map((item, index) => (
				<li class:list={["cp", { "cp--primary": item.kind === "feature" }]}>
					<div class="cp__index">
						<span class="cp__code mono">{String(index + 1).padStart(2, "0")}</span>
						<span class="cp__logo">
							<img src={item.logo} alt="" loading="lazy" width="40" height="40" />
						</span>
					</div>
					<div class="cp__body">
						{item.eyebrow && (
							<p class="cp__eyebrow" data-es={item.eyebrow.es} data-en={item.eyebrow.en}>
								{item.eyebrow.es}
							</p>
						)}
						<h3 class="cp__title" data-es={item.title.es} data-en={item.title.en}>
							{item.title.es}
						</h3>
						<p class="cp__text" data-es={item.body.es} data-en={item.body.en}>
							{item.body.es}
						</p>
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.edu {
		padding-block: clamp(4rem, 10vw, 8rem);
	}

	.edu__top {
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: end;
	}

	.edu__subtitle {
		margin-top: 1.25rem;
		max-width: var(--measure);
		font-size: var(--text-lg);
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.edu__readings {
		display: flex;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		margin: 0;
		padding-top: 0.5rem;
	}

	.reading {
		display: flex;
		flex-direction: column;
	}

	.reading__v {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--text-2xl);
		line-height: 1;
		color: var(--survey);
	}

	.reading__k {
		margin: 0.35rem 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
	}

	.edu__points {
		list-style: none;
		margin: clamp(2.5rem, 6vw, 4rem) 0 0;
		padding: 0;
		border-top: 1px solid var(--hairline);
	}

	.cp {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1rem, 3vw, 2rem);
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.cp__index {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.65rem;
		min-width: 3.5rem;
	}

	.cp__code {
		font-size: var(--text-xs);
		color: var(--ink-faint);
		letter-spacing: 0.06em;
	}

	.cp__logo {
		display: inline-grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--hairline);
		border-radius: var(--r-sm);
		background: var(--chart-raised);
	}

	.cp__logo img {
		width: 68%;
		height: 68%;
		object-fit: contain;
		filter: grayscale(1) contrast(0.9) opacity(0.82);
	}

	:global(.dark) .cp__logo img {
		filter: grayscale(1) brightness(1.6) contrast(0.9) opacity(0.85);
	}

	.cp--primary .cp__logo {
		width: 3.5rem;
		height: 3.5rem;
		border-color: var(--survey);
	}

	.cp__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--survey);
	}

	.cp__title {
		margin-top: 0.35rem;
		font-size: var(--text-xl);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.cp--primary .cp__title {
		font-size: var(--text-2xl);
	}

	.cp__text {
		margin-top: 0.7rem;
		max-width: 60ch;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--ink-muted);
	}

	@media (min-width: 900px) {
		.edu__top {
			grid-template-columns: 1.3fr 0.7fr;
		}

		.cp {
			grid-template-columns: 12rem 1fr;
		}

		.cp__index {
			flex-direction: row;
			align-items: center;
			gap: 1rem;
		}
	}
</style>
