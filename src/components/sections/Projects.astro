---
import { projects } from "../../data/projects";
import { es, en } from "../../data/i18n/strings";
import SheetHeader from "../ui/SheetHeader.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import ProjectGallery from "../projects/ProjectGallery.astro";
---

<section id="projects" class="projects atlas" aria-labelledby="projects-title">
	<div class="reveal">
		<SheetHeader
			id="projects-title"
			designation={{ es: es["projects.designation"], en: en["projects.designation"] }}
			coord="03 / 05"
			title={{ es: es["projects.title"], en: en["projects.title"] }}
		/>
	</div>

	<div class="projects__list">
		{
			projects.map((project, index) => (
				<ProjectCard project={project} index={index}>
					<ProjectGallery slot="media" project={project} />
				</ProjectCard>
			))
		}
	</div>
</section>

<style>
	.projects {
		padding-block: clamp(4rem, 10vw, 8rem);
	}

	.projects__list {
		margin-top: clamp(1.5rem, 4vw, 2.5rem);
	}

	/* close the last site with a rule so the sequence reads as a bounded plate */
	.projects__list :global(.site:last-child) {
		border-bottom: 1px solid var(--hairline);
	}
</style>
