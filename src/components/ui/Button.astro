---
interface Props {
	href?: string;
	large?: boolean;
	variant?: "primary" | "outline" | "ghost";
	target?: string;
	rel?: string;
	download?: boolean;
	ariaLabel?: string;
	ariaLabelEs?: string;
	ariaLabelEn?: string;
	icon?: boolean;
}

const {
	href,
	large = false,
	variant = "primary",
	target,
	rel,
	download,
	ariaLabel,
	ariaLabelEs,
	ariaLabelEn,
	icon = false,
} = Astro.props;
---

<a
	href={href}
	target={target}
	rel={rel}
	download={download}
	aria-label={ariaLabel}
	data-i18n-aria-es={ariaLabelEs}
	data-i18n-aria-en={ariaLabelEn}
	class:list={["control", `control--${variant}`, { "control--lg": large }, "magnetic"]}
>
	<span class="control__label"><slot /></span>
	{
		icon && (
			<svg
				class="control__icon"
				aria-hidden="true"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
			>
				<path
					d="M7 17 17 7M9 7h8v8"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		)
	}
</a>

<style>
	.control {
		display: inline-flex;
		min-height: 2.9rem;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.7rem 1.15rem;
		border-radius: var(--r-sm);
		border: 1px solid transparent;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.01em;
		transition:
			transform 160ms var(--ease-survey),
			background 160ms var(--ease-survey),
			border-color 160ms var(--ease-survey),
			color 160ms var(--ease-survey);
	}

	.control--lg {
		min-height: 3.25rem;
		padding: 0.9rem 1.5rem;
		font-size: var(--text-base);
	}

	.control:active {
		transform: translateY(1px);
	}

	/* Primary — the one committing action, in reserved survey magenta */
	.control--primary {
		background: var(--survey);
		color: var(--survey-ink);
		box-shadow: var(--shadow-lift);
	}

	.control--primary:hover {
		background: var(--survey-deep);
	}

	/* Secondary — a surveyed control with hairline registration */
	.control--outline {
		border-color: var(--hairline-strong);
		color: var(--ink);
	}

	.control--outline:hover {
		border-color: var(--survey);
		color: var(--survey);
	}

	/* Ghost — quiet mono control */
	.control--ghost {
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-weight: 500;
		letter-spacing: 0;
	}

	.control--ghost:hover {
		color: var(--survey);
	}

	.control__icon {
		flex: none;
	}
</style>
