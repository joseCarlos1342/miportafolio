---
import type { Project } from "../../types";
import { es, en } from "../../data/i18n/strings";

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const titleId = `${project.id}-title`;
const siteCode = String(index + 1).padStart(2, "0");
---

<article
	class="project-card site reveal"
	data-layout={project.media.kind === "video" ? "media-right" : project.layout}
	aria-labelledby={titleId}
>
	<div class="site__meta">
		<div class="site__tags">
			<span class="site__code mono">{siteCode}</span>
		</div>

		<h3 id={titleId} class="site__title" data-es={project.title.es} data-en={project.title.en}>
			{project.title.es}
		</h3>

		<p class="site__stack mono">{project.stack}</p>

		<p class="site__desc" data-es={project.description.es} data-en={project.description.en}>
			{project.description.es}
		</p>

		<a
			href={project.link.repo}
			target="_blank"
			rel="noreferrer"
			class="site__link magnetic"
			data-es={es["projects.viewGithub"]}
			data-en={en["projects.viewGithub"]}
		>
			{es["projects.viewGithub"]}
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M7 17 17 7M9 7h8v8"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</div>

	<div class="site__media">
		<slot name="media" />
	</div>
</article>

<style>
	.site {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		border-top: 1px solid var(--hairline);
	}

	.site__tags {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.site__code {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--survey);
		letter-spacing: 0.08em;
	}

	.site__title {
		margin-top: 1rem;
		font-size: var(--text-2xl);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.02;
		color: var(--ink);
	}

	.site__stack {
		margin-top: 0.85rem;
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
		color: var(--ink-muted);
	}

	.site__desc {
		margin-top: 1.1rem;
		max-width: 46ch;
		font-size: var(--text-base);
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.site__link {
		margin-top: 1.5rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		color: var(--ink);
		border-bottom: 1px solid var(--hairline-strong);
		padding-bottom: 0.2rem;
		transition: color 160ms var(--ease-survey), border-color 160ms var(--ease-survey);
	}

	.site__link:hover {
		color: var(--survey);
		border-color: var(--survey);
	}

	@media (min-width: 900px) {
		.site {
			grid-template-columns: 1fr 1.15fr;
		}

		.site[data-layout="media-right"] .site__meta {
			order: 1;
		}

		.site[data-layout="media-right"] .site__media {
			order: 2;
		}

		.site[data-layout="media-left"] .site__meta {
			order: 2;
		}

		.site[data-layout="media-left"] .site__media {
			order: 1;
		}
	}
</style>
