---
import type { Project } from "../../types";
import { es, en } from "../../data/i18n/strings";

interface Props {
	project: Project;
}

const { project } = Astro.props;
const label = project.title.es;
---

{
	project.media.kind === "images" ? (
		<div class="project-preview" data-carousel>
			<div class="preview-panel plate registered project-media">
				<div class="project-media__stage">
					{project.media.screens.map((screen, index) => (
						<picture
							class="carousel-slide"
							hidden={index !== 0}
							data-slide
							data-avif={screen.avif}
							data-webp={screen.webp}
							data-png={screen.png}
							data-alt={`Captura ${index + 1} de ${label}`}
						>
							<source srcset={screen.avif} type="image/avif" />
							<source srcset={screen.webp} type="image/webp" />
							<img
								src={screen.png}
								alt={`Captura ${index + 1} de ${label}`}
								loading={index === 0 ? "eager" : "lazy"}
							/>
						</picture>
					))}
				</div>
			</div>
			<div class="project-preview__bar">
				<div class="project-preview__nav">
					<button
						type="button"
						class="carousel-prev preview-control"
						aria-label={es["projects.carousel.prev"]}
						data-i18n-aria-es={es["projects.carousel.prev"]}
						data-i18n-aria-en={en["projects.carousel.prev"]}
					>
						‹
					</button>
					<button
						type="button"
						class="carousel-next preview-control"
						aria-label={es["projects.carousel.next"]}
						data-i18n-aria-es={es["projects.carousel.next"]}
						data-i18n-aria-en={en["projects.carousel.next"]}
					>
						›
					</button>
					<p class="project-preview__count tnum">
						<span data-carousel-current>1</span>
						{" / "}
						<span>{project.media.total}</span>
					</p>
				</div>
				<button
					type="button"
					class="preview-expand"
					data-lightbox-type="image"
					data-lightbox-label={label}
					data-es={es["projects.viewLarger"]}
					data-en={en["projects.viewLarger"]}
				>
					{es["projects.viewLarger"]}
				</button>
			</div>
		</div>
	) : (
		<div class="project-preview">
			<div class="preview-panel plate registered project-media">
				<div class="project-media__stage">
					<video
						class="project-video"
						autoplay
						muted
						loop
						playsinline
						controls
						preload="auto"
						aria-label={`Video preview de ${label}`}
					>
						<source src={project.media.webm} type="video/webm" />
						<source src={project.media.mp4} type="video/mp4" />
					</video>
				</div>
			</div>
			<div class="project-preview__bar project-preview__bar--end">
				<button
					type="button"
					class="preview-expand"
					data-lightbox-type="video"
					data-lightbox-src={project.media.mp4}
					data-lightbox-webm={project.media.webm}
					data-lightbox-label={label}
					data-es={es["projects.viewLarger"]}
					data-en={en["projects.viewLarger"]}
				>
					{es["projects.viewLarger"]}
				</button>
			</div>
		</div>
	)
}

<style>
	.project-preview {
		width: 100%;
	}

	.project-media {
		padding: 0.5rem;
	}

	.project-media__stage {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--r-xs);
		background: var(--chart-sink);
	}

	.project-media__stage img,
	.project-media__stage video {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.carousel-slide[hidden] {
		display: none;
	}

	.project-preview__bar {
		margin-top: 0.9rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.project-preview__bar--end {
		justify-content: flex-end;
	}

	.project-preview__nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.project-preview__count {
		margin-left: 0.35rem;
		font-size: var(--text-xs);
		color: var(--ink-muted);
	}
</style>
